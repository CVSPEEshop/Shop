{
  "name": "shop",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://cvspeeshop.github.io,https://cvspeeofficial.github.io,https://cvsupee.github.io" }
}
{
  "previews": {
    // ...
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issue_detection": {
        "enabled": false
      }
    },
    // ...
  }
}
